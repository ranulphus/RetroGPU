diff --git m/src/video/dos/SDL_glosvideo.c m/src/video/dos/SDL_glosvideo.c
new file mode 100644
index 0000000..11121c7
--- /dev/null
+++ m/src/video/dos/SDL_glosvideo.c
@@ -0,0 +1,643 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
+
+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+
+// The "glos" video driver: windows on a GLOS desktop (GLOS's PRD §10.4).
+//
+// Under GLOS, with a desktop that can show OpenGL in a window (a Matrox card
+// at 16 bits a pixel: GLOS_MACHINE_GLWIN), a program gets windows instead of the
+// screen and becomes a GLOS app. A software window's pixels are GLOS's (the
+// desktop's format, RGB565), mapped into the program: SDL draws there and
+// says where (DRAW's PRESENT). An OpenGL window is DOS-GL's (dglInit opens
+// it at context creation, of the window's size). Keys, the mouse, focus,
+// size and close requests come as GLOS events. A "fullscreen" window is a
+// window of the mode's size: the desktop stays. Otherwise (plain DOS, another
+// desktop) the "vesa" driver takes the screen as before.
+
+#include "SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_DOSVESA
+
+#include "../../core/dos/SDL_glos.h"
+#include "../../core/dos/SDL_dos_scheduler.h"
+#include "../../events/SDL_events_c.h"
+#include "../../events/SDL_keyboard_c.h"
+#include "../../events/SDL_mouse_c.h"
+#include "../../events/SDL_windowevents_c.h"
+#include "../SDL_sysvideo.h"
+#include "SDL_dosevents_c.h"
+#include "SDL_dosvideo.h"
+
+#ifdef SDL_VIDEO_OPENGL_DOSGL
+#include <GL/dosgl.h>
+#endif
+
+// Window sizes offered as "fullscreen" modes: those that fit on the desktop
+// with a frame, a title bar and the task bar.
+static const int glos_sizes[][2] = { { 320, 200 }, { 320, 240 }, { 400, 300 }, { 512, 384 }, { 640, 400 },
+                                     { 640, 480 }, { 800, 600 }, { 1024, 768 }, { 1280, 1024 } };
+
+static int glos_desk_w, glos_desk_h;
+
+static bool GLOS_SetRelativeMouseMode(bool enabled);
+
+static SDL_Window *GLOS_WindowOf(SDL_VideoDevice *device, unsigned id)
+{
+    for (SDL_Window *w = device->windows; w; w = w->next) {
+        if (w->internal && w->internal->glos_id == id) {
+            return w;
+        }
+    }
+    return NULL;
+}
+
+static bool GLOS_VideoInit(SDL_VideoDevice *device)
+{
+    GLOS_Screen scr;
+    SDL_VideoDisplay vdisplay;
+    SDL_DisplayMode mode;
+
+    if (!GLOS_BecomeApp()) {
+        return SDL_SetError("GLOS: the program can't be a GLOS app here");
+    }
+    SDL_zero(scr);
+    scr.size = sizeof(scr);
+    if (GLOS_Call(GLOS_DRAW_SCREEN, &scr) != 0 || scr.format.bpp != 16) {
+        return SDL_SetError("GLOS: no 16-bit desktop");
+    }
+    glos_desk_w = scr.work_w; // (the screen less the task bar: what a window can fill)
+    glos_desk_h = scr.work_h;
+
+    SDL_zero(mode);
+    mode.format = SDL_PIXELFORMAT_RGB565;
+    mode.w = scr.w;
+    mode.h = scr.h;
+    mode.pixel_density = 1.0f;
+    SDL_zero(vdisplay);
+    vdisplay.desktop_mode = mode;
+    vdisplay.name = (char *)"GLOS desktop";
+    if (!SDL_AddVideoDisplay(&vdisplay, false)) {
+        return false;
+    }
+    SDL_GetMouse()->internal = NULL;
+    SDL_GetMouse()->SetRelativeMouseMode = GLOS_SetRelativeMouseMode;
+    device->internal->glos_have_mouse = true;
+    return true;
+}
+
+static bool GLOS_GetDisplayModes(SDL_VideoDevice *device, SDL_VideoDisplay *display)
+{
+    (void)device;
+    for (int i = 0; i < (int)SDL_arraysize(glos_sizes); i++) {
+        SDL_DisplayMode mode;
+        if (glos_sizes[i][0] > glos_desk_w - 8 || glos_sizes[i][1] > glos_desk_h - 28) {
+            continue;
+        }
+        SDL_zero(mode);
+        mode.format = SDL_PIXELFORMAT_RGB565;
+        mode.w = glos_sizes[i][0];
+        mode.h = glos_sizes[i][1];
+        mode.pixel_density = 1.0f;
+        SDL_AddFullscreenDisplayMode(display, &mode);
+    }
+    return true;
+}
+
+static bool GLOS_SetDisplayMode(SDL_VideoDevice *device, SDL_VideoDisplay *display, SDL_DisplayMode *mode)
+{
+    (void)device;
+    (void)display;
+    (void)mode; // the desktop keeps its mode: a "fullscreen" window is a window of the mode's size
+    return true;
+}
+
+static void GLOS_VideoQuit(SDL_VideoDevice *device)
+{
+    (void)device;
+}
+
+static void GLOS_Destroy(SDL_VideoDevice *device)
+{
+    SDL_free(device->internal);
+    SDL_free(device);
+}
+
+// The window's GLOS pixels as SDL's framebuffer (a software window).
+static bool GLOS_Pixels(SDL_Window *window)
+{
+    SDL_WindowData *wd = window->internal;
+    GLOS_PixelsInfo g;
+    SDL_zero(g);
+    g.size = sizeof(g);
+    g.handle = wd->glos_id;
+    if (GLOS_Call(GLOS_DRAW_PIXELS, &g) != 0) {
+        return SDL_SetError("GLOS: no pixels for the window");
+    }
+    wd->glos_pixels = GLOS_Pointer(g.pixels);
+    wd->glos_pitch = (int)g.pitch;
+    window->w = g.w;
+    window->h = g.h;
+    return wd->glos_pixels != NULL;
+}
+
+static void GLOS_Show(unsigned handle, unsigned state)
+{
+    GLOS_WinShow v;
+    v.size = sizeof(v);
+    v.handle = handle;
+    v.state = state;
+    v.flags = 0;
+    GLOS_Call(GLOS_WIN_SHOW, &v);
+}
+
+static void GLOS_Title(unsigned handle, const char *title)
+{
+    GLOS_Prop q;
+    SDL_zero(q);
+    q.size = sizeof(q);
+    q.handle = handle;
+    q.prop = GLOS_PROP_WIN_TITLE;
+    q.data = (unsigned)title;
+    q.room = (unsigned)SDL_strlen(title);
+    if (q.room > 63) {
+        q.room = 63;
+    }
+    GLOS_Call(GLOS_CORE_SET, &q);
+}
+
+static bool GLOS_CreateWindow(SDL_VideoDevice *device, SDL_Window *window, SDL_PropertiesID create_props)
+{
+    SDL_WindowData *wd = (SDL_WindowData *)SDL_calloc(1, sizeof(SDL_WindowData));
+    GLOS_WinCreate g;
+    int w = window->floating.w, h = window->floating.h;
+    (void)create_props;
+    if (!wd) {
+        return false;
+    }
+    window->internal = wd;
+    if (window->requested_fullscreen_mode.w > 0 && (window->flags & SDL_WINDOW_FULLSCREEN)) {
+        w = window->requested_fullscreen_mode.w;
+        h = window->requested_fullscreen_mode.h;
+    }
+    if (w <= 0 || h <= 0) {
+        w = 640, h = 480;
+    }
+    window->floating.w = window->windowed.w = window->w = w;
+    window->floating.h = window->windowed.h = window->h = h;
+    if (window->flags & SDL_WINDOW_OPENGL) {
+        return true; // DOS-GL opens it, at the context's creation
+    }
+    SDL_zero(g);
+    g.size = sizeof(g);
+    g.w = w;
+    g.h = h;
+    g.kind = GLOS_WK_NORMAL;
+    g.flags = GLOS_WF_ANYWHERE | ((window->flags & SDL_WINDOW_RESIZABLE) ? 0 : GLOS_WF_FIXED);
+    SDL_strlcpy(g.title, window->title ? window->title : "SDL", sizeof(g.title));
+    if (GLOS_Call(GLOS_WIN_CREATE, &g) != 0) {
+        return SDL_SetError("GLOS: no window of %dx%d", w, h);
+    }
+    wd->glos_id = g.handle; // (the window's handle: what GLOS's calls and events name it by)
+    if (!(window->flags & SDL_WINDOW_HIDDEN)) {
+        GLOS_Show(wd->glos_id, GLOS_WS_NORMAL);
+    }
+    return true;
+}
+
+static void GLOS_SetWindowTitle(SDL_VideoDevice *device, SDL_Window *window)
+{
+    (void)device;
+    if (window->internal->glos_id) {
+        GLOS_Title(window->internal->glos_id, window->title ? window->title : "");
+    }
+}
+
+static void GLOS_ShowWindow(SDL_VideoDevice *device, SDL_Window *window)
+{
+    (void)device;
+    if (window->internal->glos_id) {
+        GLOS_Show(window->internal->glos_id, GLOS_WS_NORMAL);
+    }
+}
+
+static void GLOS_HideWindow(SDL_VideoDevice *device, SDL_Window *window)
+{
+    (void)device;
+    if (window->internal->glos_id) {
+        GLOS_Show(window->internal->glos_id, GLOS_WS_HIDDEN);
+    }
+}
+
+static void GLOS_RaiseWindow(SDL_VideoDevice *device, SDL_Window *window)
+{
+    GLOS_WinFocus f;
+    (void)device;
+    if (window->internal->glos_id) {
+        f.size = sizeof(f);
+        f.handle = window->internal->glos_id;
+        f.id = 0;
+        GLOS_Call(GLOS_WIN_FOCUS, &f);
+    }
+}
+
+static void GLOS_SetWindowSize(SDL_VideoDevice *device, SDL_Window *window)
+{
+    GLOS_WinPlace pl;
+    (void)device;
+    if (!window->internal->glos_id || (window->flags & SDL_WINDOW_OPENGL)) {
+        return; // an OpenGL window's size is its context's: a new context for another
+    }
+    SDL_zero(pl);
+    pl.size = sizeof(pl);
+    pl.handle = window->internal->glos_id;
+    pl.what = GLOS_PLACE_SIZE;
+    pl.w = window->pending.w;
+    pl.h = window->pending.h;
+    if (GLOS_Call(GLOS_WIN_PLACE, &pl) == 0) {
+        window->surface_valid = false;
+        SDL_SendWindowEvent(window, SDL_EVENT_WINDOW_RESIZED, window->pending.w, window->pending.h);
+    }
+}
+
+static SDL_FullscreenResult GLOS_SetWindowFullscreen(SDL_VideoDevice *device, SDL_Window *window,
+                                                     SDL_VideoDisplay *display, SDL_FullscreenOp fullscreen)
+{
+    (void)device;
+    (void)display;
+    if (fullscreen != SDL_FULLSCREEN_OP_LEAVE && window->requested_fullscreen_mode.w > 0 && !window->internal->glos_id) {
+        // Before an OpenGL context: the window simply has the mode's size.
+        window->floating.w = window->windowed.w = window->w = window->requested_fullscreen_mode.w;
+        window->floating.h = window->windowed.h = window->h = window->requested_fullscreen_mode.h;
+    }
+    return SDL_FULLSCREEN_SUCCEEDED;
+}
+
+static void GLOS_GetWindowSizeInPixels(SDL_VideoDevice *device, SDL_Window *window, int *w, int *h)
+{
+    (void)device;
+    *w = window->w;
+    *h = window->h;
+}
+
+static void GLOS_DestroyWindow(SDL_VideoDevice *device, SDL_Window *window)
+{
+    SDL_WindowData *wd = window->internal;
+    (void)device;
+    if (wd && wd->glos_id && !(window->flags & SDL_WINDOW_OPENGL)) {
+        GLOS_Close_(wd->glos_id);
+    }
+#ifdef SDL_VIDEO_OPENGL_DOSGL
+    if ((window->flags & SDL_WINDOW_OPENGL) && device->internal->gl_context_active) {
+        dglShutdown(); // the program never destroyed the context: DOS-GL closes its window
+        device->internal->gl_context_active = false;
+    }
+    if (device->internal->gl_window == window) {
+        device->internal->gl_window = NULL;
+    }
+#endif
+    SDL_free(wd);
+    window->internal = NULL;
+}
+
+// ---- software windows
+
+static bool GLOS_CreateWindowFramebuffer(SDL_VideoDevice *device, SDL_Window *window, SDL_PixelFormat *format,
+                                         void **pixels, int *pitch)
+{
+    (void)device;
+    if (!window->internal->glos_id) {
+        return SDL_SetError("GLOS: an OpenGL window has no framebuffer");
+    }
+    if (!GLOS_Pixels(window)) {
+        return false;
+    }
+    *format = SDL_PIXELFORMAT_RGB565;
+    *pixels = window->internal->glos_pixels;
+    *pitch = window->internal->glos_pitch;
+    return true;
+}
+
+static bool GLOS_UpdateWindowFramebuffer(SDL_VideoDevice *device, SDL_Window *window, const SDL_Rect *rects,
+                                         int numrects)
+{
+    GLOS_Present pr;
+    (void)device;
+    SDL_zero(pr);
+    pr.size = sizeof(pr);
+    pr.handle = window->internal->glos_id;
+    if (numrects <= 0 || numrects > 16) {
+        return GLOS_Call(GLOS_DRAW_PRESENT, &pr) == 0; // (w 0: all of it)
+    }
+    for (int i = 0; i < numrects; i++) {
+        pr.x = rects[i].x, pr.y = rects[i].y, pr.w = rects[i].w, pr.h = rects[i].h;
+        if (pr.w > 0 && pr.h > 0) {
+            GLOS_Call(GLOS_DRAW_PRESENT, &pr);
+        }
+    }
+    return true;
+}
+
+static void GLOS_DestroyWindowFramebuffer(SDL_VideoDevice *device, SDL_Window *window)
+{
+    (void)device;
+    window->internal->glos_pixels = NULL;
+}
+
+// ---- events
+
+static Uint8 GLOS_Button(unsigned b)
+{
+    return b == 1 ? SDL_BUTTON_LEFT : b == 2 ? SDL_BUTTON_RIGHT : SDL_BUTTON_MIDDLE;
+}
+
+static void GLOS_PumpEvents(SDL_VideoDevice *device)
+{
+    SDL_VideoData *data = device->internal;
+    static union
+    {
+        GLOS_Ev ev;
+        GLOS_EvKey key;
+        GLOS_EvText text;
+        GLOS_EvMouse mouse;
+        GLOS_EvWheel wheel;
+        GLOS_EvFocus focus;
+        GLOS_EvSize size;
+        unsigned char room[GLOS_EV_MAX];
+    } e;
+    DOS_Yield(); // cooperative threads (the audio thread) run here, as with the vesa driver
+    for (;;) {
+        SDL_Window *window;
+        GLOS_Wait w;
+        SDL_zero(w);
+        w.size = sizeof(w);
+        w.buffer = (unsigned)&e;
+        w.room = sizeof(e);
+        if (GLOS_Call(GLOS_CORE_EVENT, &w) != 0 || w.length == 0) { // (ms 0: a look; none waits)
+            break;
+        }
+        window = GLOS_WindowOf(device, e.ev.handle);
+        switch (e.ev.kind) {
+        case GLOS_EV_KEY: {
+            unsigned code = e.key.key & 0x7F;
+            SDL_Scancode sc = (e.key.key & 0x100) ? DOSVESA_ExtendedScancodeMapping[code] : DOSVESA_ScancodeMapping[code];
+            if (sc == SDL_SCANCODE_UNKNOWN) {
+                break;
+            }
+            SDL_SendKeyboardKey(0, SDL_GLOBAL_KEYBOARD_ID, (int)e.key.key, sc, e.key.down != 0);
+            break;
+        }
+        case GLOS_EV_TEXT: // (what the key typed, as GLOS made it: apart from the key itself in API 2.0)
+            if (e.text.ch >= 32 && e.text.ch != 127 && !(SDL_GetModState() & (SDL_KMOD_CTRL | SDL_KMOD_ALT))) {
+                char text[5];
+                *SDL_UCS4ToUTF8(e.text.ch, text) = '\0';
+                SDL_SendKeyboardText(text);
+            }
+            break;
+        case GLOS_EV_MOUSE:
+            if (!window) {
+                break;
+            }
+            if (data->glos_relative) {
+                SDL_SendMouseMotion(0, window, SDL_GLOBAL_MOUSE_ID, true, (float)e.mouse.x - data->glos_mouse_x,
+                                    (float)e.mouse.y - data->glos_mouse_y);
+            } else {
+                SDL_SendMouseMotion(0, window, SDL_GLOBAL_MOUSE_ID, false, (float)e.mouse.x, (float)e.mouse.y);
+            }
+            data->glos_mouse_x = (float)e.mouse.x;
+            data->glos_mouse_y = (float)e.mouse.y;
+            if (e.mouse.button) { // a button changed
+                SDL_SendMouseButton(0, window, SDL_GLOBAL_MOUSE_ID, GLOS_Button(e.mouse.button), e.mouse.down != 0);
+            }
+            break;
+        case GLOS_EV_WHEEL:
+            if (window) {
+                SDL_SendMouseWheel(0, window, SDL_GLOBAL_MOUSE_ID, 0.0f, (float)e.wheel.notches, SDL_MOUSEWHEEL_NORMAL);
+            }
+            break;
+        case GLOS_EV_FOCUS:
+            if (window) {
+                SDL_SetKeyboardFocus(e.focus.got ? window : NULL);
+                SDL_SetMouseFocus(e.focus.got ? window : NULL);
+            }
+            break;
+        case GLOS_EV_SIZE:
+            if (window) {
+                window->surface_valid = false; // its pixels are elsewhere now
+                SDL_SendWindowEvent(window, SDL_EVENT_WINDOW_RESIZED, e.size.w, e.size.h);
+            }
+            break;
+        case GLOS_EV_CLOSE:
+            if (window) {
+                SDL_SendWindowEvent(window, SDL_EVENT_WINDOW_CLOSE_REQUESTED, 0, 0);
+            }
+            break;
+        case GLOS_EV_END: // GLOS asks the app to end (glos exit, the Task Manager): as a quit
+            SDL_SendQuit();
+            break;
+        }
+    }
+}
+
+static bool GLOS_SetRelativeMouseMode(bool enabled)
+{
+    SDL_VideoDevice *device = SDL_GetVideoDevice();
+    if (device && device->internal) {
+        device->internal->glos_relative = enabled;
+    }
+    return true;
+}
+
+// ---- OpenGL windows: DOS-GL's own, in a window of its own
+
+#ifdef SDL_VIDEO_OPENGL_DOSGL
+#if defined(DGL_API_VERSION) && DGL_API_VERSION >= 0x0103
+static void GLOS_GL_WaitHook(void *arg)
+{
+    (void)arg;
+    DOS_Yield();
+}
+#endif
+
+static bool GLOS_GL_LoadLibrary(SDL_VideoDevice *device, const char *path)
+{
+    (void)device;
+    (void)path;
+    return true;
+}
+
+static SDL_FunctionPointer GLOS_GL_GetProcAddress(SDL_VideoDevice *device, const char *proc)
+{
+    (void)device;
+    return (SDL_FunctionPointer)dglGetProcAddress(proc);
+}
+
+static void GLOS_GL_UnloadLibrary(SDL_VideoDevice *device)
+{
+    (void)device;
+}
+
+static SDL_GLContext GLOS_GL_CreateContext(SDL_VideoDevice *device, SDL_Window *window)
+{
+    SDL_VideoData *data = device->internal;
+    DGLConfig cfg;
+    if (!(window->flags & SDL_WINDOW_OPENGL)) {
+        SDL_SetError("GLOS: not an OpenGL window");
+        return NULL;
+    }
+    if (data->gl_context_active) {
+        SDL_SetError("DOS-GL: one OpenGL context at a time");
+        return NULL;
+    }
+    SDL_zero(cfg);
+    cfg.width = window->w;
+    cfg.height = window->h;
+    cfg.color_bits = 16;
+    cfg.depth_bits = device->gl_config.depth_size > 0 ? 16 : 0;
+    cfg.double_buffer = device->gl_config.double_buffer ? 1 : 0;
+    cfg.vsync = data->gl_swap_interval != 0;
+    if (dglInit(&cfg) != 0) {
+        SDL_SetError("DOS-GL: %s", dglGetErrorString());
+        return NULL;
+    }
+    data->gl_context_active = true;
+    data->gl_window = window;
+#if defined(DGL_API_VERSION) && DGL_API_VERSION >= 0x0104
+    window->internal->glos_id = dglGetGlosWindow();
+#endif
+    if (window->internal->glos_id && window->title) {
+        GLOS_Title(window->internal->glos_id, window->title);
+    }
+#if defined(DGL_API_VERSION) && DGL_API_VERSION >= 0x0103
+    dglSetWaitHook(GLOS_GL_WaitHook, NULL);
+#endif
+    SDL_SetKeyboardFocus(window);
+    SDL_SetMouseFocus(window);
+    return (SDL_GLContext)data;
+}
+
+static bool GLOS_GL_MakeCurrent(SDL_VideoDevice *device, SDL_Window *window, SDL_GLContext context)
+{
+    (void)device;
+    (void)window;
+    (void)context;
+    return true;
+}
+
+static bool GLOS_GL_SetSwapInterval(SDL_VideoDevice *device, int interval)
+{
+    device->internal->gl_swap_interval = interval ? 1 : 0;
+    dglSetVSync(device->internal->gl_swap_interval);
+    return true;
+}
+
+static bool GLOS_GL_GetSwapInterval(SDL_VideoDevice *device, int *interval)
+{
+    *interval = device->internal->gl_swap_interval;
+    return true;
+}
+
+static bool GLOS_GL_SwapWindow(SDL_VideoDevice *device, SDL_Window *window)
+{
+    (void)device;
+    (void)window;
+    DOS_Yield();
+    dglSwapBuffers();
+    return true;
+}
+
+static bool GLOS_GL_DestroyContext(SDL_VideoDevice *device, SDL_GLContext context)
+{
+    SDL_VideoData *data = device->internal;
+    (void)context;
+    if (data->gl_context_active) {
+#if defined(DGL_API_VERSION) && DGL_API_VERSION >= 0x0103
+        dglSetWaitHook(NULL, NULL);
+#endif
+        dglShutdown(); // DOS-GL closes its window
+        data->gl_context_active = false;
+        if (data->gl_window && data->gl_window->internal) {
+            data->gl_window->internal->glos_id = 0;
+        }
+    }
+    return true;
+}
+#endif
+
+static SDL_VideoDevice *GLOS_CreateDevice(void)
+{
+    SDL_VideoDevice *device;
+    const char *want = SDL_GetHint(SDL_HINT_VIDEO_DRIVER);
+    if (want && SDL_strcasecmp(want, "glos") != 0) {
+        return NULL; // (asked for another by name)
+    }
+    if (!(GLOS_Caps() & GLOS_MACHINE_GLWIN)) {
+        return NULL; // plain DOS, or a desktop that can't show this program: the vesa driver's screen
+    }
+    device = (SDL_VideoDevice *)SDL_calloc(1, sizeof(SDL_VideoDevice));
+    if (!device) {
+        return NULL;
+    }
+    device->internal = (SDL_VideoData *)SDL_calloc(1, sizeof(SDL_VideoData));
+    if (!device->internal) {
+        SDL_free(device);
+        return NULL;
+    }
+    device->free = GLOS_Destroy;
+    device->VideoInit = GLOS_VideoInit;
+    device->VideoQuit = GLOS_VideoQuit;
+    device->GetDisplayModes = GLOS_GetDisplayModes;
+    device->SetDisplayMode = GLOS_SetDisplayMode;
+    device->CreateSDLWindow = GLOS_CreateWindow;
+    device->SetWindowTitle = GLOS_SetWindowTitle;
+    device->ShowWindow = GLOS_ShowWindow;
+    device->HideWindow = GLOS_HideWindow;
+    device->RaiseWindow = GLOS_RaiseWindow;
+    device->SetWindowSize = GLOS_SetWindowSize;
+    device->SetWindowFullscreen = GLOS_SetWindowFullscreen;
+    device->GetWindowSizeInPixels = GLOS_GetWindowSizeInPixels;
+    device->DestroyWindow = GLOS_DestroyWindow;
+    device->CreateWindowFramebuffer = GLOS_CreateWindowFramebuffer;
+    device->UpdateWindowFramebuffer = GLOS_UpdateWindowFramebuffer;
+    device->DestroyWindowFramebuffer = GLOS_DestroyWindowFramebuffer;
+    device->PumpEvents = GLOS_PumpEvents;
+#ifdef SDL_VIDEO_OPENGL_DOSGL
+    device->internal->gl_swap_interval = 1;
+    device->GL_LoadLibrary = GLOS_GL_LoadLibrary;
+    device->GL_GetProcAddress = GLOS_GL_GetProcAddress;
+    device->GL_UnloadLibrary = GLOS_GL_UnloadLibrary;
+    device->GL_CreateContext = GLOS_GL_CreateContext;
+    device->GL_MakeCurrent = GLOS_GL_MakeCurrent;
+    device->GL_SetSwapInterval = GLOS_GL_SetSwapInterval;
+    device->GL_GetSwapInterval = GLOS_GL_GetSwapInterval;
+    device->GL_SwapWindow = GLOS_GL_SwapWindow;
+    device->GL_DestroyContext = GLOS_GL_DestroyContext;
+#endif
+    return device;
+}
+
+VideoBootStrap GLOS_bootstrap = {
+    "glos",
+    "GLOS desktop windows",
+    GLOS_CreateDevice,
+    NULL,
+    false
+};
