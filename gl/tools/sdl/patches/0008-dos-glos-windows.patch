index 0000000..1c7f9c1
--- /dev/null
+++ m/src/core/dos/SDL_glos.c
@@ -0,0 +1,107 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
+
+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+
+#include "SDL_internal.h"
+
+#ifdef SDL_PLATFORM_DOS
+
+#include "SDL_glos.h"
+#include <dpmi.h>
+#include <sys/nearptr.h>
+
+static struct
+{
+    unsigned long off;
+    unsigned short sel;
+} glos_entry;
+static int glos_found; // 1 GLOS, -1 none
+
+int GLOS_Call(unsigned fn, void *s)
+{
+    unsigned char failed;
+    unsigned a, b, c = 0, d = 0;
+    if (glos_found <= 0) {
+        return -1;
+    }
+    do { // (again while a wait was cut short for an interrupt of the program's own: ECX and EDX as GLOS left them)
+        a = fn;
+        b = (unsigned)s;
+        __asm__ __volatile__("lcall *%[e]\n\tsetc %[f]"
+                             : "+a"(a), "+b"(b), "+c"(c), "+d"(d), [f] "=m"(failed)
+                             : [e] "m"(glos_entry)
+                             : "esi", "edi", "cc", "memory");
+    } while (failed && a == GLOS_E_AGAIN);
+    return failed ? (int)a : 0;
+}
+
+unsigned GLOS_Caps(void)
+{
+    GLOS_Version v;
+    if (!glos_found) {
+        __dpmi_paddr p;
+        glos_found = -1;
+        if (__dpmi_get_vendor_specific_api_entry_point("GLOS", &p) == 0) {
+            glos_entry.off = p.offset32;
+            glos_entry.sel = p.selector;
+            glos_found = 1;
+        }
+    }
+    SDL_zero(v);
+    v.size = sizeof(v);
+    if (GLOS_Call(GLOS_CORE_VERSION, &v) != 0 || v.major != 2) {
+        return 0;
+    }
+    return v.machine;
+}
+
+bool GLOS_BecomeApp(void)
+{
+    static GLOS_Init in;
+    int r;
+    if (!GLOS_Caps()) {
+        return false;
+    }
+    SDL_zero(in);
+    in.size = sizeof(in);
+    in.major = 2; // the API version SDL is built for
+    in.minor = 0;
+    SDL_strlcpy(in.name, "SDL", sizeof(in.name)); // (its windows have their own titles)
+    r = GLOS_Call(GLOS_CORE_INIT, &in);
+    return r == 0 || (r == GLOS_E_INIT && in.why == GLOS_WHY_ALREADY);
+}
+
+void GLOS_Close_(unsigned handle)
+{
+    GLOS_Close c;
+    c.size = sizeof(c);
+    c.handle = handle;
+    GLOS_Call(GLOS_CORE_CLOSE, &c);
+}
+
+void *GLOS_Pointer(unsigned linear)
+{
+    if (!linear || !__djgpp_nearptr_enable()) {
+        return NULL;
+    }
+    return (void *)(linear + __djgpp_conventional_base);
+}
+
+#endif // SDL_PLATFORM_DOS
diff --git m/src/core/dos/SDL_glos.h m/src/core/dos/SDL_glos.h
new file mode 100644
index 0000000..881fcdb
--- /dev/null
+++ m/src/core/dos/SDL_glos.h
@@ -0,0 +1,230 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
+
+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+
+// GLOS: a graphical DOS whose DPMI host answers 0A00h "GLOS" with an API of
+// windows, events and a sound mixer (GLOS's include/glos/api2.h: API 2.0).
+// A program run under it gets windows instead of the screen: SDL's "glos"
+// video and audio drivers (SDL_glosvideo.c, SDL_glosaudio.c) use these.
+//
+// A call is a function number in EAX and a structure in EBX whose first word
+// is its size; the carry flag says it failed, with GLOS's error in EAX. What
+// follows is the part of the API these drivers use, as GLOS's header has it.
+
+#ifndef SDL_glos_h_
+#define SDL_glos_h_
+
+#include "SDL_internal.h"
+
+#define GLOS_FN(area, n) ((2u << 16) | ((unsigned)(area) << 8) | (unsigned)(n))
+#define GLOS_CORE_VERSION GLOS_FN(0, 0)
+#define GLOS_CORE_INIT GLOS_FN(0, 1)
+#define GLOS_CORE_CLOSE GLOS_FN(0, 2)
+#define GLOS_CORE_SET GLOS_FN(0, 4)
+#define GLOS_CORE_EVENT GLOS_FN(0, 5)
+#define GLOS_WIN_CREATE GLOS_FN(1, 0)
+#define GLOS_WIN_SHOW GLOS_FN(1, 1)
+#define GLOS_WIN_PLACE GLOS_FN(1, 2)
+#define GLOS_WIN_FOCUS GLOS_FN(1, 3)
+#define GLOS_DRAW_PIXELS GLOS_FN(2, 0)
+#define GLOS_DRAW_PRESENT GLOS_FN(2, 1)
+#define GLOS_DRAW_SCREEN GLOS_FN(2, 2)
+#define GLOS_AUDIO_OUT GLOS_FN(10, 0)
+
+#define GLOS_E_INIT 5
+#define GLOS_E_AGAIN 20
+#define GLOS_WHY_ALREADY 1
+
+#define GLOS_MACHINE_GPU 1
+#define GLOS_MACHINE_GLWIN 2
+#define GLOS_MACHINE_AUDIO 4
+
+#define GLOS_EV(area, n) ((unsigned short)(((unsigned)(area) << 8) | (unsigned)(n)))
+#define GLOS_EV_END GLOS_EV(0, 3)
+#define GLOS_EV_FOCUS GLOS_EV(1, 1)
+#define GLOS_EV_SIZE GLOS_EV(1, 2)
+#define GLOS_EV_CLOSE GLOS_EV(1, 4)
+#define GLOS_EV_KEY GLOS_EV(3, 1)
+#define GLOS_EV_MOUSE GLOS_EV(3, 2)
+#define GLOS_EV_WHEEL GLOS_EV(3, 3)
+#define GLOS_EV_TEXT GLOS_EV(3, 4)
+#define GLOS_EV_MAX 256
+
+#define GLOS_WK_NORMAL 0
+#define GLOS_WF_FIXED 1
+#define GLOS_WF_ANYWHERE 4
+#define GLOS_WS_HIDDEN 0
+#define GLOS_WS_NORMAL 1
+#define GLOS_PLACE_SIZE 2
+#define GLOS_PROP_WIN_TITLE ((2u << 8) | 0u) // GLOS_PROP(GLOS_HK_WINDOW, 0)
+
+typedef struct
+{
+    unsigned size, major, minor, machine;
+} GLOS_Version; // (its head: GLOS fills as much as the size says)
+
+typedef struct
+{
+    unsigned size, major, minor;
+    char name[32], help[32], category[32];
+    unsigned flags, app, why;
+} GLOS_Init;
+
+typedef struct
+{
+    unsigned size, handle;
+} GLOS_Close;
+
+typedef struct
+{
+    unsigned size, handle, prop;
+    int value;
+    unsigned data, room, length;
+} GLOS_Prop;
+
+typedef struct
+{
+    unsigned size, ms, areas, buffer, room, length;
+} GLOS_Wait;
+
+typedef struct
+{
+    unsigned size;
+    unsigned short kind, flags;
+    unsigned handle, time;
+} GLOS_Ev;
+
+typedef struct
+{
+    GLOS_Ev ev;
+    unsigned key, ch, mods, down, repeat;
+} GLOS_EvKey;
+
+typedef struct
+{
+    GLOS_Ev ev;
+    unsigned ch, mods;
+} GLOS_EvText;
+
+typedef struct
+{
+    GLOS_Ev ev;
+    int x, y, dx, dy;
+    unsigned buttons, button, down, mods, clicks;
+} GLOS_EvMouse;
+
+typedef struct
+{
+    GLOS_Ev ev;
+    int x, y, notches;
+    unsigned buttons, mods;
+} GLOS_EvWheel;
+
+typedef struct
+{
+    GLOS_Ev ev;
+    unsigned got;
+} GLOS_EvFocus;
+
+typedef struct
+{
+    GLOS_Ev ev;
+    int w, h;
+} GLOS_EvSize;
+
+typedef struct
+{
+    unsigned size, kind, flags;
+    int x, y, w, h;
+    unsigned owner;
+    char title[64];
+    unsigned handle;
+} GLOS_WinCreate;
+
+typedef struct
+{
+    unsigned size, handle, state, flags;
+} GLOS_WinShow;
+
+typedef struct
+{
+    unsigned size, handle, what;
+    int x, y, w, h;
+} GLOS_WinPlace;
+
+typedef struct
+{
+    unsigned size, handle, id;
+} GLOS_WinFocus;
+
+typedef struct
+{
+    unsigned bpp;
+    unsigned char rpos, rsize, gpos, gsize, bpos, bsize, pad[2];
+} GLOS_Format;
+
+typedef struct
+{
+    unsigned size, handle, pixels, pitch;
+    int w, h;
+    GLOS_Format format;
+} GLOS_PixelsInfo;
+
+typedef struct
+{
+    unsigned size, handle;
+    int x, y, w, h;
+} GLOS_Present;
+
+typedef struct
+{
+    unsigned size;
+    int w, h;
+    GLOS_Format format;
+    int work_x, work_y, work_w, work_h;
+} GLOS_Screen;
+
+typedef struct
+{
+    unsigned size, rate, channels, bytes, handle, ring, id;
+} GLOS_AudioOut;
+
+typedef struct
+{
+    unsigned size, rate, channels, bytes;
+    volatile unsigned write, read, periods, underruns;
+    unsigned mixer_rate, period_frames;
+    volatile unsigned volume;
+    unsigned ring;
+} GLOS_Stream; // (GLOS's struct glos_audio_ring: the stream's header, in memory the two share)
+
+// What the machine can do (GLOS_MACHINE_), 0 without a GLOS that speaks API 2.0.
+extern unsigned GLOS_Caps(void);
+// Function fn with its structure (NULL for a call that has none): 0, or
+// GLOS's error code.
+extern int GLOS_Call(unsigned fn, void *s);
+// The program a GLOS app (or one already): true.
+extern bool GLOS_BecomeApp(void);
+// Any handle closed.
+extern void GLOS_Close_(unsigned handle);
+// A linear address GLOS gave, as a pointer (near pointers are on: SDL_RunApp).
+extern void *GLOS_Pointer(unsigned linear);
+
+#endif // SDL_glos_h_
