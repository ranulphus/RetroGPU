[General]
confirm_exit = 0
confirm_save = 0
confirm_reset = 0
sound_gain = 0

[Machine]
machine = @MACHINE@
cpu_family = @CPU_FAMILY@
cpu_speed = @CPU_SPEED@
cpu_multi = @CPU_MULTI@
cpu_use_dynarec = @DYNAREC@
fpu_type = internal
mem_size = @MEM_KB@
time_sync = disabled

@MACHINE_EXTRA@[Video]
gfxcard = @GFXCARD@
voodoo = @VOODOO@

[@GFXNAME@]
memory = @G100_MB@

[3DFX Voodoo Graphics]
type = voodoo
framebuffer_memory = 2
texture_memory = 2
render_threads = @VOODOO_THREADS@
recompiler = @VOODOO_RECOMPILER@
bilinear = 1
dithersub = 1

[Input devices]
keyboard_type = keyboard_ps2
mouse_type = @MOUSE@
@JOYSTICK@
[Sound]
sndcard = @SNDCARD@

[Storage controllers]
hdc = internal
fdc = internal

[Ports (COM & LPT)]
serial1_enabled = 1
serial1_device = file
serial2_enabled = @COM2@
lpt1_enabled = @LPT1@

[File (COM) #1]
path = @SERIAL@
append = 0

[Hard disks]
hdd_01_parameters = 63, 16, @CYLS@, 0, ide
hdd_01_fn = @CIMG@
hdd_01_ide_channel = 0:0
@EXTRA_HDD@

[Floppy and CD-ROM drives]
fdd_01_type = 35_2hd
fdd_01_fn = @BOOTIMG@
fdd_01_check_bpb = 0
fdd_02_type = none

[Other peripherals]
unittester_enabled = 1

[86Box Unit Tester]
exit_enabled = 1
@TAIL@