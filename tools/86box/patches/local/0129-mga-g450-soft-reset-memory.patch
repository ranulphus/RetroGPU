+/* Local patch 0129: an uninitialised G450's VRAM decays: every 2 s of
+ * emulated time since the reset (or the last decay) it turns to noise. */
+static void
+g450_mem_decay(svga_t *svga, mystique_t *m)
+{
+    uint32_t i, x;
+
+    if (!m->g450_used) {
+        m->g450_used = 1;
+        mga_hazard(HZ_G450_MEM, "VRAM used after a soft reset without the G450's memory set-up (MACCESS bit 15)");
+    }
+    if (!cpu_s || (tsc - m->g450_since) < 2ull * (uint64_t) cpu_s->rspeed)
+        return;
+    m->g450_since = tsc;
+    x = m->g450_noise ? m->g450_noise : 0x2545F491u;
+    for (i = 0; i + 4 <= svga->vram_max; i += 4) {
+        x ^= x << 13;
+        x ^= x >> 17;
+        x ^= x << 5;
+        *(uint32_t *) &svga->vram[i] = x;
+    }
+    m->g450_noise = x;
+    memset(svga->changedvram, svga->monitor->mon_changeframecount, svga->vram_max >> 12);
+    mga_hazard(HZ_G450_MEM, "VRAM decayed: a soft reset without the G450's memory set-up (MACCESS bit 15) since");
+}
