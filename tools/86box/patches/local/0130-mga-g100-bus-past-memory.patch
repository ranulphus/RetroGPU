+/* MGA-Glide local patch 0130: a real G100 (bench-g400's, 4 MB in a 16 MB
+ * aperture, 2026-11-18, RetroGPU tests/hal/vrambus.c) neither mirrors nor
+ * pulls up the frame buffer past its memory: a write there is lost, and a
+ * read gives the data lines' last value: what was last written.
+ * So a VRAM probe that reads back straight after its write finds memory that
+ * isn't there. Only writes set that value: a read of memory that is there
+ * leaves it as it was (measured). bytes 1 or 2: those lanes of the dword at
+ * addr's place. */
+static void
+g100_bus_lane(mystique_t *m, uint32_t addr, uint32_t val, int bytes)
+{
+    const int      sh   = (int) (addr & (bytes == 2 ? 2 : 3)) * 8;
+    const uint32_t mask = (bytes == 2 ? 0xffffu : 0xffu) << sh;
+    m->g100_bus         = (m->g100_bus & ~mask) | ((val << sh) & mask);
+}
+
 static uint8_t
 mystique_readb_linear(uint32_t addr, void *priv)
 {
